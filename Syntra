local function normalizeValue(v)
    if type(v) == "boolean" then return v and "True" or "False" end
    if v == nil then return "" end
    return tostring(v)
end

local function applyRealFlags()
    if not CONFIG.ApplyRealFlags then return 0, 0 end
    if not setfflag then
        log("setfflag() not exposed - using script-level FFlag emulation only.")
        return 0, #FLAGS
    end

    local applied, failed = 0, 0
    for i = 1, #FLAGS do
        local flag = FLAGS[i]
        local name, value = flag[1], flag[2]

        if CONFIG.RestoreRealFlags and getfflag then
            local ok, old = pcall(getfflag, name)
            if ok and old ~= nil then
                State.realFlagsSet[name] = old
            end
        end

        if pcall(setfflag, name, value) then
            applied = applied + 1
        else
            failed = failed + 1
        end
    end
    return applied, failed
end

local function restoreRealFlags()
    if not (CONFIG.RestoreRealFlags and setfflag and getfflag) then return end
    for name, old in pairs(State.realFlagsSet) do
        pcall(setfflag, name, normalizeValue(old))
    end
    State.realFlagsSet = {}
end

local function applyFpsCap()
    if not (CONFIG.UncapFPS and setfpscap) then return end
    if getfpscap then
        local ok, cap = pcall(getfpscap)
        if ok then State.originalFpsCap = cap end
    end
    pcall(setfpscap, CONFIG.FpsCap)
end

local function restoreFpsCap()
    if not setfpscap then return end
    local target = State.originalFpsCap
    if target == nil then target = CONFIG.FpsCapOnDisable end
    pcall(setfpscap, target)
end

-- ====================== SCRIPT-LEVEL FFLAG-LIKE ==========================
-- One pass over the world for parts/lights/effects (avoids repeated
-- Workspace:GetDescendants() scans). Weak keys mean destroyed instances are
-- collected automatically instead of leaking.
local function applyWorld()
    local savedParts    = setmetatable({}, { __mode = "k" })
    local savedLights   = setmetatable({}, { __mode = "k" })
    local savedFx       = setmetatable({}, { __mode = "k" }) -- particles/beams/trails
    local savedDecals   = setmetatable({}, { __mode = "k" })
    local savedSurfaces = setmetatable({}, { __mode = "k" })
    local savedMats     = setmetatable({}, { __mode = "k" })

    local function process(inst)
        -- Shadows (FIntRenderShadowIntensity = 0)
        if CONFIG.DisableShadows then
            if inst:IsA("BasePart") then
                if savedParts[inst] == nil then savedParts[inst] = inst.CastShadow end
                pcall(function() inst.CastShadow = false end)
            elseif inst:IsA("Light") then
                if savedLights[inst] == nil then savedLights[inst] = inst.Shadows end
                pcall(function() inst.Shadows = false end)
            end
        end

        -- Material flattening (FIntRenderMeshOptimizeVertexBuffer style win)
        if CONFIG.FlattenMaterials and inst:IsA("BasePart") then
            if savedMats[inst] == nil then
                savedMats[inst] = { material = inst.Material, reflectance = inst.Reflectance }
            end
            pcall(function()
                inst.Material = Enum.Material.SmoothPlastic
                inst.Reflectance = 0
            end)
        end

        -- Textures / decals (DFIntTextureQualityOverride = 0)
        if CONFIG.ReduceDecals then
            if inst:IsA("Decal") or inst:IsA("Texture") then
                if savedDecals[inst] == nil then savedDecals[inst] = inst.Transparency end
                pcall(function() inst.Transparency = 1 end)
            elseif inst:IsA("SurfaceAppearance") then
                if savedSurfaces[inst] == nil then savedSurfaces[inst] = inst.Parent end
                pcall(function() inst.Parent = nil end)
            end
        end

        -- Particles (FFlagFixOutdatedParticles2 / deterministic particles)
        if CONFIG.StripParticles then
            if inst:IsA("ParticleEmitter") or inst:IsA("Fire")
                or inst:IsA("Smoke") or inst:IsA("Sparkles") then
                if savedFx[inst] == nil then savedFx[inst] = inst.Enabled end
                pcall(function() inst.Enabled = false end)
            end
        end

        -- Beams / trails / explosions
        if CONFIG.StripBeamsTrails then
            if inst:IsA("Beam") or inst:IsA("Trail") then
                if savedFx[inst] == nil then savedFx[inst] = inst.Enabled end
                pcall(function() inst.Enabled = false end)
            elseif inst:IsA("Explosion") then
                if savedFx[inst] == nil then savedFx[inst] = inst.Visible end
                pcall(function() inst.Visible = false end)
            end
        end
    end

    for _, inst in ipairs(Workspace:GetDescendants()) do
        pcall(process, inst)
    end

    local conn = Workspace.DescendantAdded:Connect(function(inst)
        if State.enabled then pcall(process, inst) end
    end)

    return function()
        conn:Disconnect()
        for inst, v in pairs(savedParts) do
            if typeof(inst) == "Instance" and inst.Parent then
                pcall(function() inst.CastShadow = v end)
            end
        end
        for inst, v in pairs(savedLights) do
            if typeof(inst) == "Instance" and inst.Parent then
                pcall(function() inst.Shadows = v end)
            end
        end
        for inst, v in pairs(savedFx) do
            if typeof(inst) == "Instance" and inst.Parent then
                if inst:IsA("Explosion") then
                    pcall(function() inst.Visible = v end)
                else
                    pcall(function() inst.Enabled = v end)
                end
            end
        end
        for inst, v in pairs(savedDecals) do
            if typeof(inst) == "Instance" and inst.Parent then
                pcall(function() inst.Transparency = v end)
            end
        end
        for inst, parent in pairs(savedSurfaces) do
            if typeof(inst) == "Instance" and parent then
                pcall(function() inst.Parent = parent end)
            end
        end
        for inst, v in pairs(savedMats) do
            if typeof(inst) == "Instance" and inst.Parent then
                pcall(function()
                    inst.Material = v.material
                    inst.Reflectance = v.reflectance
                end)
            end
        end
    end
end

-- Lighting: post-FX, atmosphere, clouds, sky + global lighting flattening.
local function applyLightingFx()
    local savedPost     = setmetatable({}, { __mode = "k" })
    local savedAtmos    = {}   -- {instance, parent}
    local savedClouds   = setmetatable({}, { __mode = "k" }) -- {enabled, cover}
    local savedSky      = {}   -- {instance, parent}
    local bloom         = nil
    local bloomCreated  = false

    local savedGlobals = {}
    for _, prop in ipairs({
        "GlobalShadows", "ShadowSoftness",
        "EnvironmentDiffuseScale", "EnvironmentSpecularScale",
    }) do
        local ok, value = pcall(function() return Lighting[prop] end)
        if ok then savedGlobals[prop] = value end
    end

    local function killPostFx(inst)
        if not inst:IsA("PostEffect") then return end
        if savedPost[inst] == nil then savedPost[inst] = inst.Enabled end
        pcall(function() inst.Enabled = false end)
    end

    local function process(inst)
        if CONFIG.DisablePostFX and inst:IsA("PostEffect") then
            killPostFx(inst)
        elseif CONFIG.DisableAtmosphere and inst:IsA("Atmosphere") then
            savedAtmos[#savedAtmos + 1] = { inst, inst.Parent }
            pcall(function() inst.Parent = nil end)
        elseif CONFIG.DisableClouds and inst:IsA("Clouds") then
            if savedClouds[inst] == nil then
                local info = {}
                pcall(function() info.enabled = inst.Enabled end)
                pcall(function() info.cover = inst.Cover end)
                savedClouds[inst] = info
            end
            pcall(function() inst.Enabled = false end)
            pcall(function() inst.Cover = 0 end)
        elseif CONFIG.DisableSky and inst:IsA("Sky") then
            savedSky[#savedSky + 1] = { inst, inst.Parent }
            pcall(function() inst.Parent = nil end)
        end
    end

    if CONFIG.FlattenLighting then
        pcall(function()
            Lighting.ShadowSoftness = 0
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0
        end)
    end

    for _, inst in ipairs(Lighting:GetDescendants()) do
        pcall(process, inst)
    end

    -- Optional Bloom, mirroring the original script's look.
    if CONFIG.EnableBloom then
        bloom = Lighting:FindFirstChildOfClass("BloomEffect")
        if not bloom then
            bloom = Instance.new("BloomEffect")
            bloom.Name = "SyntraBloom"
            bloomCreated = true
            bloom.Parent = Lighting
        end
        pcall(function()
            bloom.Enabled = true
            bloom.Intensity = 1.5
            bloom.Size = 24
            bloom.Threshold = 0.8
        end)
    end

    local conn = Lighting.DescendantAdded:Connect(function(inst)
        if State.enabled then pcall(process, inst) end
    end)

    return function()
        conn:Disconnect()

        for inst, v in pairs(savedPost) do
            if typeof(inst) == "Instance" and inst.Parent then
                pcall(function() inst.Enabled = v end)
            end
        end
        for _, entry in ipairs(savedAtmos) do
            if entry[1] then pcall(function() entry[1].Parent = entry[2] end) end
        end
        for inst, v in pairs(savedClouds) do
            if typeof(inst) == "Instance" and inst.Parent then
                if v.enabled ~= nil then
                    pcall(function() inst.Enabled = v.enabled end)
                end
                if v.cover ~= nil then
                    pcall(function() inst.Cover = v.cover end)
                end
            end
        end
        for _, entry in ipairs(savedSky) do
            if entry[1] then pcall(function() entry[1].Parent = entry[2] end) end
        end

        if bloomCreated and bloom and bloom.Parent then
            bloom:Destroy()
        end

        for k, v in pairs(savedGlobals) do
            pcall(function() Lighting[k] = v end)
        end
    end
end

-- Terrain water calm + global wind calm.
local function applyTerrain()
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if not terrain then return nil end

    local saved = {}
    if CONFIG.CalmWater then
        pcall(function() saved.WaterWaveSize = terrain.WaterWaveSize end)
        pcall(function() saved.WaterWaveSpeed = terrain.WaterWaveSpeed end)
        pcall(function()
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
        end)
    end

    local savedWind
    if CONFIG.CalmWind then
        local ok, wind = pcall(function() return Workspace.GlobalWind end)
        if ok then savedWind = wind end
        pcall(function() Workspace.GlobalWind = Vector3.zero end)
    end

    return function()
        if CONFIG.CalmWater then
            if saved.WaterWaveSize ~= nil then
                pcall(function() terrain.WaterWaveSize = saved.WaterWaveSize end)
            end
            if saved.WaterWaveSpeed ~= nil then
                pcall(function() terrain.WaterWaveSpeed = saved.WaterWaveSpeed end)
            end
        end
        if CONFIG.CalmWind and savedWind then
            pcall(function() Workspace.GlobalWind = savedWind end)
        end
    end
end

