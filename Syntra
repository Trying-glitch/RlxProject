local function resolveGuiParent()
    if gethui then
        local ok, parent = pcall(gethui)
        if ok and parent then return parent end
    end
    if localPlayer then
        local ok2, pg = pcall(function() return localPlayer:WaitForChild("PlayerGui", 5) end)
        if ok2 and pg then return pg end
    end
    local ok, core = pcall(function() return game:GetService("CoreGui") end)
    if ok and core then return core end
    return nil
end

local function buildOverlay()
    local parent = resolveGuiParent()
    if not parent then return nil, nil end

    local gui = Instance.new("ScreenGui")
    gui.Name = "SyntraHighFPS"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 1000

    local frame = Instance.new("Frame")
    frame.Name = "Panel"
    frame.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
    frame.BackgroundTransparency = 0.35
    frame.BorderSizePixel = 0
    frame.Position = UDim2.new(0, 12, 0, 12)
    frame.Size = UDim2.fromOffset(170, 74)
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 200, 140)
    stroke.Transparency = 0.4
    stroke.Parent = frame

    local label = Instance.new("TextLabel")
    label.Name = "Stats"
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.Code
    label.TextSize = 14
    label.TextColor3 = Color3.fromRGB(0, 230, 160)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.Padding = UDim.new(0, 4)
    label.Text = "FPS: --"
    label.Parent = frame

    gui.Parent = parent

    local frames, acc = 0, 0
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        frames = frames + 1
        acc = acc + dt
        if acc >= 0.5 then
            local fps = frames / acc
            frames, acc = 0, 0

            local ping = "--"
            pcall(function()
                local item = Stats.Network.ServerStatsItem["Data Ping"]
                if item then ping = string.format("%d", item:GetValue()) end
            end)

            local mem = "--"
            pcall(function()
                mem = string.format("%d", Stats:GetTotalMemoryUsageMb())
            end)

            label.Text = string.format("FPS: %d\nPing: %s ms\nMem: %s MB", fps, ping, mem)
        end
    end)

    return gui, conn
end

-- ============================== ENABLE / DISABLE =========================
local enable, disable

-- Run a script-level layer without ever letting one failure abort enable().
local function runLayer(fn)
    local ok, restore = pcall(fn)
    if ok then
        pushRestore(restore)
    else
        log("optimization layer skipped:", tostring(restore))
    end
end

enable = function()
    if State.enabled then return end
    State.enabled = true

    -- 1. Real FFlags + FPS cap -------------------------------------------
    local applied, failed = applyRealFlags()
    if setfflag then
        log(string.format("Real FFlags applied: %d | failed/skipped: %d", applied, failed))
    end
    applyFpsCap()

    -- 2. Script-level FFlag-like layer -----------------------------------
    if CONFIG.DisablePostFX or CONFIG.DisableAtmosphere or CONFIG.DisableClouds
        or CONFIG.DisableSky or CONFIG.FlattenLighting then
        runLayer(applyLightingFx)
    end
    if CONFIG.DisableShadows or CONFIG.ReduceDecals or CONFIG.FlattenMaterials
        or CONFIG.StripParticles or CONFIG.StripBeamsTrails then
        runLayer(applyWorld)
    end
    if CONFIG.CalmWater or CONFIG.CalmWind then
        runLayer(applyTerrain)
    end

    -- 3. Overlay ----------------------------------------------------------
    if CONFIG.ShowFPS then
        local ok, gui, conn = pcall(buildOverlay)
        if ok then
            State.overlay = gui
            State.overlayConn = conn
        else
            log("FPS overlay unavailable in this context; skipping.")
        end
    end

    log("High-FPS mode ENABLED.")
end

disable = function()
    if not State.enabled then return end
    State.enabled = false

    for i = #State.restores, 1, -1 do
        pcall(State.restores[i])
    end
    State.restores = {}

    if State.overlayConn then
        pcall(function() State.overlayConn:Disconnect() end)
        State.overlayConn = nil
    end
    if State.overlay then
        pcall(function() State.overlay:Destroy() end)
        State.overlay = nil
    end

    restoreRealFlags()
    restoreFpsCap()

    log("High-FPS mode DISABLED. Original settings restored.")
end

