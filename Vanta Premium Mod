RunService.RenderStepped:Connect(function(dt)
    if not visualizerEnabled then 
        cleanVisualizerParts()
        return 
    end
    
    -- Ensure visual elements are persistent and recreated on swept parent camera
    if not outerVisualizerPart or not outerVisualizerPart.Parent or not innerVisualizerPart or not innerVisualizerPart.Parent then
        createVisualizerParts()
    end
    
    local char = LocalPlayer.Character
    local primaryPart = char and char.PrimaryPart
    local ball = Util.get_ball()
    
    if not (primaryPart and ball) then
        outerVisualizerPart.Size = Vector3.zero
        innerVisualizerPart.Size = Vector3.zero
        return
    end
    
    local zoomies = ball:FindFirstChild("zoomies")
    local ballSpeed = zoomies and zoomies.VectorVelocity.Magnitude or ball.AssemblyLinearVelocity.Magnitude
    local target = ball:GetAttribute("target")
    local isTargetingPlayer = (target == LocalPlayer.Name)
    
    -- -------------------------------------------------------------
    -- 1. Outer Ball Orb: Follows the Ball
    -- -------------------------------------------------------------
    -- Scales slowly with ball velocity to show ball's general threat volume. 
    -- We divide and clamp parameters to keep the size balanced.
    local targetOuterRadius = math.clamp((ballSpeed * 0.06) + 3, 5, 25)
    smoothedOuterRadius = smoothedOuterRadius + (targetOuterRadius - smoothedOuterRadius) * dt * 4.5 -- Lower smoothing index to keep it smooth
    
    local outerDiameter = smoothedOuterRadius * 2
    outerVisualizerPart.Size = Vector3.new(outerDiameter, outerDiameter, outerDiameter)
    outerVisualizerPart.CFrame = ball.CFrame
    
    if isTargetingPlayer then
        outerVisualizerPart.Color = Color3.fromRGB(255, 30, 30) -- Red warning when targeted
        outerVisualizerPart.Transparency = 0.82
    else
        outerVisualizerPart.Color = Color3.fromRGB(240, 240, 245) -- Pale white when safe
        outerVisualizerPart.Transparency = 0.90
    end
    
    -- -------------------------------------------------------------
    -- 2. Glowing Inner Player Orb: Follows Player
    -- -------------------------------------------------------------
    -- Predicts parry limits based on ping values. Fits exact mathematical trigger zone
    local calculatedInnerRadius = calculate_parry_radius(ball)
    
    -- Clamp the inner radius size to prevent bloated/unrealistic visuals
    local targetInnerRadius = math.clamp(calculatedInnerRadius, 8, 70)
    smoothedInnerRadius = smoothedInnerRadius + (targetInnerRadius - smoothedInnerRadius) * dt * 5.0 -- Damped interpolation
    
    local innerDiameter = smoothedInnerRadius * 2
    innerVisualizerPart.Size = Vector3.new(innerDiameter, innerDiameter, innerDiameter)
    innerVisualizerPart.CFrame = primaryPart.CFrame
    
    -- React directly to states (glowing neon blue/purple for Auto Spam active)
    if isSpamModeActive() then
        innerVisualizerPart.Color = Color3.fromRGB(150, 0, 255) -- Deep glowing purple when Auto Spam is Active
        innerVisualizerPart.Transparency = 0.55 -- Lower transparency makes it appear more bright/solid
    elseif isTargetingPlayer then
        innerVisualizerPart.Color = Color3.fromRGB(255, 0, 50) -- Intense red when parry is incoming
        innerVisualizerPart.Transparency = 0.65
    else
        innerVisualizerPart.Color = Color3.fromRGB(240, 240, 245) -- Elegant pale white when safe
        innerVisualizerPart.Transparency = 0.85
    end
end)

