-- Dual-Orb Dynamic Visualizer Subsystem (Outer Ball and Inner Player Visualizers)

local visualizerEnabled = false
local outerVisualizerPart = nil -- Tracks the ball
local innerVisualizerPart = nil -- Tracks the player (glowing inner parry prediction indicator)

local smoothedOuterRadius = 0
local smoothedInnerRadius = 0

local function isSpamModeActive()
    return _G.AutoSpamValue or _G.manual_spam or false
end

-- Calculates the math-synchronized parry radius matching the auto-parry engine
local function calculate_parry_radius(ball)
    if not ball then return 0 end
    local zoomies = ball:FindFirstChild("zoomies")
    if not zoomies then return 0 end
    
    local speed = zoomies.VectorVelocity.Magnitude
    local pingMs = Stats.Network.ServerStatsItem:GetValue()
    local pingClamp = math.clamp((pingMs / 10) / 10, 5, 17)
    local speedAdjust = math.min(math.max(speed - 9.5, 0), 650)
    
    local timingBase = 2.4 + speedAdjust * 0.002
    local timingScale = accuracyMultiplier
    local timingFinal = timingBase * timingScale
    local parryDistance = pingClamp + math.max(speed / timingFinal, 9.5)
    
    if isSpamModeActive() then
        return 25 -- Clashing / auto spam execution radius limit
    end
    
    return parryDistance
end

local function cleanVisualizerParts()
    if outerVisualizerPart then pcall(function() outerVisualizerPart:Destroy() end) outerVisualizerPart = nil end
    if innerVisualizerPart then pcall(function() innerVisualizerPart:Destroy() end) innerVisualizerPart = nil end
end

local function createVisualizerParts()
    cleanVisualizerParts()
    
    -- 1. Outer Ball Visualizer (around the ball)
    outerVisualizerPart = Instance.new("Part")
    outerVisualizerPart.Name = "VantaOuterBallVisualizer"
    outerVisualizerPart.Shape = Enum.PartType.Ball
    outerVisualizerPart.Anchored = true
    outerVisualizerPart.CanCollide = false
    outerVisualizerPart.CanTouch = false
    outerVisualizerPart.CanQuery = false
    outerVisualizerPart.CastShadow = false
    outerVisualizerPart.Material = Enum.Material.ForceField
    outerVisualizerPart.Transparency = 0.90 -- Thin outer danger boundary
    outerVisualizerPart.Color = Color3.fromRGB(240, 240, 245)
    outerVisualizerPart.Parent = workspace.CurrentCamera
    
    -- 2. Inner Player Visualizer (around player representing parry prediction)
    innerVisualizerPart = Instance.new("Part")
    innerVisualizerPart.Name = "VantaInnerPlayerVisualizer"
    innerVisualizerPart.Shape = Enum.PartType.Ball
    innerVisualizerPart.Anchored = true
    innerVisualizerPart.CanCollide = false
    innerVisualizerPart.CanTouch = false
    innerVisualizerPart.CanQuery = false
    innerVisualizerPart.CastShadow = false
    innerVisualizerPart.Material = Enum.Material.ForceField
    innerVisualizerPart.Transparency = 0.70 -- More opaque, glowing inner sphere
    innerVisualizerPart.Color = Color3.fromRGB(240, 240, 245)
    innerVisualizerPart.Parent = workspace.CurrentCamera
end

VisualTab:AddToggle("VisualizerToggle", {
    Title   = "ball visualizer",
    Default = false,
