local function isValidRemoteArgs(args)
    return #args == 7
        and type(args[span_0](start_span)[span_0](end_span))    == "string"
        and type(args[span_3](start_span)[span_3](end_span))    == "number"
        and typeof(args[span_6](start_span)[span_6](end_span))  == "CFrame"
        and type(args[span_8](start_span)[span_8](end_span))    == "table"
        and type(args[span_9](start_span)[span_9](end_span))    == "table"
        and type(args[span_10](start_span)[span_10](end_span))    == "boolean"
end

local function hookRemote(remote)
    if hookedRemotes[remote] then return end
    local mt = getrawmetatable(remote)
    if hookedMetatables[mt] then return end
    hookedMetatables[mt] = true
    setreadonly(mt, false)
    local originalIndex = mt.__index
    mt.__index = function(self, key)
        if (key == "FireServer" and self:IsA("RemoteEvent"))
        or (key == "InvokeServer" and self:IsA("RemoteFunction")) then
            return function(selfArg,...)
                local args = {...}
                if isValidRemoteArgs(args) and not hookedRemotes[self] then
                    hookedRemotes[self] = args
                    lastActionName = args
              [span_1](start_span)[span_1](end_span)  end
                return originalIndex(self, key)(selfArg, unpack(args))
            end
        end
        return originalIndex(self, key)
    end
    setreadonly(mt, true)
end

