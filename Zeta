		_G.config.ball_debug = enabled
		if enabled then
			ballStatsGui = Instance.new("ScreenGui")
			ballStatsGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
			ballStatsGui.ResetOnSpawn = false
			local label = Instance.new("TextLabel")
			label.Parent = ballStatsGui
			label.Size = UDim2.new(0.2, 0, 0.05, 0)
			label.Position = UDim2.new(0.7, 0, 0.1, 0)
			label.TextSize = 26
			label.BackgroundTransparency = 1
			label.TextColor3 = Color3.new(1, 1, 1)
			label.Font = Enum.Font.Fantasy
			label.Text = "waiting..."
			local maxSpeedPerBall = {}
			activeConnections.ball_stats = RunService.Heartbeat:Connect(function()
				local balls = Util.get_balls() or {}
				if #balls == 0 then
					label.Text = "waiting..."
					label.TextColor3 = Color3.new(1, 1, 1)
					return
				end
				for ball in pairs(maxSpeedPerBall) do
					if not table.find(balls, ball) then
						maxSpeedPerBall[ball] = nil
					end
				end
				local highestSpeed = 0
				local fastestBall
				for _, ball in ipairs(balls) do
					local zoomies = ball:FindFirstChild("zoomies")
					if zoomies then
						local speed = zoomies.VectorVelocity.Magnitude
						local prev = maxSpeedPerBall[ball] or 0
						local peak = math.max(prev, speed)
						maxSpeedPerBall[ball] = peak
						if peak > highestSpeed then
							highestSpeed = peak
							fastestBall = ball
						end
					end
				end
				if fastestBall then
					local atLimit = highestSpeed >= 2200
					local text = ("ball velocity: %.0f"):format(highestSpeed)
					if atLimit then text = text.. " (LIMIT!)" end
					label.Text = text
					label.TextColor3 = atLimit and Color3.new(1, 0, 0) or Color3.new(1, 1, 1)
				else
					label.Text = "waiting..."
					label.TextColor3 = Color3.new(1, 1, 1)
				end
			end)
		else
			if activeConnections.ball_stats then
				activeConnections.ball_stats:Disconnect()
				activeConnections.ball_stats = nil
			end
			if ballStatsGui then
				ballStatsGui:Destroy()
				ballStatsGui = nil
			end
		end
	end,
	section = "left"
})

