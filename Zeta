			autoSpamCoroutine = coroutine.create(function(signal)
				local RunService = game:GetService("RunService")
				local lastSpamTick = 0
				local isCurrentlySpamming = false -- Track state for notifications

				while _G.config.auto_spam and (signal ~= "stop") do
					local ball = Util.get_ball()
					if ball and ball:IsDescendantOf(workspace) then
						local zoomies = ball:FindFirstChild("zoomies")
						if zoomies then
							Util.closest_player()
							local targetPlayer = closestTarget or _G.closestTarget
							if targetPlayer and targetPlayer.PrimaryPart and targetPlayer:IsDescendantOf(workspace) then
								local playerDistance = LocalPlayer:DistanceFromCharacter(ball.Position)
								local targetPosition = targetPlayer.PrimaryPart.Position
								local targetDistance = LocalPlayer:DistanceFromCharacter(targetPosition)
								
								-- Threshold Trigger Calculation
								local ballVelocity = ball.AssemblyLinearVelocity.Magnitude
								local ballSpeed = math.max(ballVelocity, 0)
								local ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
								local pingThreshold = math.clamp(ping / 10, 10, 16)
								local ballProperties = Util:get_ball_properties()
								local entityProperties = Util:players_properties()
								local threshold = _G.config.spam_threshold or 3
										
								local spamAccuracy = Util.perfom_spam({
									Ball_Properties = ballProperties,
									Entity_Properties = entityProperties,
									Ping = pingThreshold,
									Spam_Sensitivity = threshold
								})
								
								local currentParryCount = Parries or _G.parryCount or 0
								
								-- Determine if we should be spamming
								local shouldSpam = (zoomies.Parent == ball) and ((playerDistance <= 30) or (targetDistance <= 30)) and (currentParryCount > 1)

								if shouldSpam then
									-- Start spam notification
									if not isCurrentlySpamming then
										isCurrentlySpamming = true
										Notify({Title = "Auto Spam", Content = "Spamming Active", Duration = 2})
									end

									if tick() - lastSpamTick > 0.1 then
										lastSpamTick = tick()
										local spamAmount = math.clamp(math.floor(ballSpeed / 30), 5, 20)
										task.spawn(function()
											for i = 1, spamAmount do
												Util.parry()
												task.wait(math.random(0.02, 0.04)) -- Added randomization to prevent kicks
											end
										end)
									end
								else
									-- Stop spam notification
									if isCurrentlySpamming then
										isCurrentlySpamming = false
										Notify({Title = "Auto Spam", Content = "Spamming Inactive", Duration = 2})
									end
								end
							end
						end
					end
					task.wait(0.001)
				end
			end)
			coroutine.resume(autoSpamCoroutine)
		else
			if autoSpamCoroutine then
				coroutine.resume(autoSpamCoroutine, "stop")
				autoSpamCoroutine = nil
			end
		end
	end,
	section = "right"
})

