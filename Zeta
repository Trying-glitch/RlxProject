MainTab.create_description_toggle({
    name = "Auto Parry",
    description = "Automatically parry when targeted with dynamic timing",
    flag = "auto_parry",
    enabled = _G.config.auto_parry or false,
    callback = function(enabled)
        _G.config.auto_parry = enabled
        if enabled then
            activeConnections.auto_parry = RunService.PreSimulation:Connect(function()
                local ballList = Util.get_balls()
                
                for _, b in ipairs(ballList) do
                    if not b then continue end
                    local zoom = b:FindFirstChild("zoomies")
                    if not zoom then continue end
                    
                    b:GetAttributeChangedSignal("target"):Once(function() 
                        parryFlag = false 
                    end)
                    
                    if parryFlag then continue end
                    
                    local ballTarget = b:GetAttribute("target")
                    local isCurved = Util.detectCurve(b)
                    
                    if ballTarget ~= tostring(LocalPlayer) and isCurved then 
                        continue 
                    end
                    
                    local vel = zoom.VectorVelocity
                    local spd = vel.Magnitude
                    local dist = (LocalPlayer.Character.PrimaryPart.Position - b.Position).Magnitude
                    local ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
                    
                    -- DYNAMIC CALCULATION: Fixes slow ball "late" parry
                    local baseThreshold = 20 
                    local speedAdjustment = math.clamp(spd / 50, 0, 25) 
                    local pingAdjustment = (ping * spd * 0.7) 
                    local parryThresh = baseThreshold + speedAdjustment + pingAdjustment
                    
                    if ballTarget == tostring(LocalPlayer) and dist <= parryThresh then
                        Util.parry(_G.config.curve_method)
                        parryFlag = true
                    end
                    
                    local lastCycle = tick()
                    task.spawn(function()
                        repeat 
                            RunService.PreSimulation:Wait() 
                        until (tick() - lastCycle) >= 1 or not parryFlag
                        parryFlag = false
                    end)
                end
            end)
        else
            if activeConnections.auto_parry then
                activeConnections.auto_parry:Disconnect()
                activeConnections.auto_parry = nil
            end
        end
    end,
    section = "left"
})

