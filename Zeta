-----------------------------------------------------------
-- 3. Execution Engine & Parry Data
-----------------------------------------------------------
local parryFlag = false
local lastParryTime = 0
local configParryCooldown = 0.01
local Parries = 0

local function computeParryData(mode)
    local eventTable = {}
    local cam = workspace.CurrentCamera
    local currentMousePos = {cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2}

    for _, ent in ipairs(workspace.Alive:GetChildren()) do
		if ent.PrimaryPart then
        	eventTable[tostring(ent)] = cam:WorldToScreenPoint(ent.PrimaryPart.Position)
		end
    end

    local camPos = cam.CFrame.Position
    if mode == "camera" or mode == "Custom" then
        return { 0, cam.CFrame, eventTable, currentMousePos }
    elseif mode == "backwards" then
        return { 0, CFrame.new(camPos, camPos - (cam.CFrame.LookVector * 1000)), eventTable, currentMousePos }
    elseif mode == "random" then
        return { 0, CFrame.new(camPos, Vector3.new(math.random(-3000,3000), math.random(-3000,3000), math.random(-3000,3000))), eventTable, currentMousePos }
    elseif mode == "straight" then
        return { 0, CFrame.new(camPos, camPos + (cam.CFrame.LookVector * 1000)), eventTable, currentMousePos }
	elseif mode == "dot" then
		local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local targetPos = (closestTarget and closestTarget.PrimaryPart and closestTarget.PrimaryPart.Position) or (hrp and hrp.Position + cam.CFrame.LookVector * 1000) or camPos
		return { 0, CFrame.lookAt(hrp and hrp.Position or camPos, targetPos + Vector3.new(0, 1.75, 0)), eventTable, currentMousePos }
    else
        return { 0, cam.CFrame, eventTable, currentMousePos }
    end
end

function Util.parry(overrideMode)
	local mode = overrideMode or _G.config.curve_method or "camera"
	if tick() - lastParryTime < configParryCooldown then return end
    lastParryTime = tick()

    local Parry_Data = computeParryData(mode)
    local curveCFrame = Parry_Data[2]
    local playerScreenPositions = Parry_Data[3]
    local cursorPos = Parry_Data[4]
    
    for remote, originalArgs in pairs(hookedRemotes) do
        local modifiedArgs = {
            originalArgs[1], originalArgs[2], originalArgs[3],
            curveCFrame, playerScreenPositions, cursorPos, originalArgs[7],
        }
        if remote:IsA("RemoteEvent") then
            remote:FireServer(unpack(modifiedArgs))
        elseif remote:IsA("RemoteFunction") then
            remote:InvokeServer(unpack(modifiedArgs))
        end
    end

    if Parries > 7 then return end
    Parries += 1
    task.delay(0.5, function() if Parries > 0 then Parries -= 1 end end)
end

