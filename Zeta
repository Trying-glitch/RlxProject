-- 4. New Math & Curve Detection
-----------------------------------------------------------
local function lerp(a, b, t)
    return a + (b - a) * t
end

function Util.detectCurve(ball)
    if not ball or not LocalPlayer.Character or not LocalPlayer.Character.PrimaryPart then return false end
    local zoom = ball:FindFirstChild("zoomies")
    if not zoom then return false end

    local ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    local speed = zoom.VectorVelocity.Magnitude
    local distance = (LocalPlayer.Character.PrimaryPart.Position - ball.Position).Magnitude
    local reachTime = distance / math.max(speed, 1) - ping

    local ballDir = zoom.VectorVelocity.Unit
    local toBall = (LocalPlayer.Character.PrimaryPart.Position - ball.Position).Unit
    local dotVal = toBall:Dot(ballDir)

    if dotVal >= 0.97 then return false end

    local speedThreshold = lerp(7, 30, math.min(speed / 1000, 1))
    local angleThreshold = 30 * math.max(dotVal, 0)
    local dotThreshold = lerp(0.2, 0.4, math.min(ping, 1)) - ping
    local ballDistanceThreshold = 10 - math.min(distance / 1000, 10) + speedThreshold + angleThreshold

    if speed > 100 and reachTime > ping * 6 then
        ballDistanceThreshold = math.max(ballDistanceThreshold - 15, 10)
    end

    if distance < ballDistanceThreshold then return false end
    return dotVal < dotThreshold
end

function Util.get_ball_properties()
	local ball = Util.get_ball()
	local velocity = Vector3.zero
	local toPlayer = (LocalPlayer.Character.PrimaryPart.Position - ball.Position).Unit
	local distance = (LocalPlayer.Character.PrimaryPart.Position - ball.Position).Magnitude
	local dot = toPlayer:Dot(velocity.Unit)
	return { Velocity = velocity, Direction = toPlayer, Distance = distance, Dot = dot }
end

function Util.players_properties()
	Util.closest_player()
	if not closestTarget then return false end
	local velocity = closestTarget.PrimaryPart.Velocity
	local direction = (LocalPlayer.Character.PrimaryPart.Position - closestTarget.PrimaryPart.Position).Unit
	local distance = (LocalPlayer.Character.PrimaryPart.Position - closestTarget.PrimaryPart.Position).Magnitude
	return { velocity = velocity, direction = direction, distance = distance }
end

local spamRadius = 0
function Util.perfom_spam(params)
	local ballProps = Util.ball.properties
	local ball = Util.get_ball()
	local target = Util.closest_player()
	if not ball then return false end
	if not target or not target.PrimaryPart then return false end
	local velocity = ball.AssemblyLinearVelocity
	local speed = velocity.Magnitude
	local toPlayer = (LocalPlayer.Character.PrimaryPart.Position - ball.Position).Unit
	local dot = toPlayer:Dot(velocity.Unit)
	local targetPos = target.PrimaryPart.Position
	local distToTarget = LocalPlayer:DistanceFromCharacter(targetPos)
	local baseRadius = params.Ping + math.min(speed / 6, 6)
	if params.Entity_Properties.distance > baseRadius then return spamRadius end
	if params.Ball_Properties.Distance > baseRadius then return spamRadius end
	if distToTarget > baseRadius then return spamRadius end
	local dotBonus = 5 - math.min(speed / 5, 5)
	local dotPenalty = math.clamp(dot, - 1, 0) * dotBonus
	spamRadius = baseRadius - dotPenalty
	return spamRadius
end

